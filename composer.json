{
    "name": "maxrzdev/dummyjson-user-client",
    "description": "Framework-agnostic PHP 8.4 client for the DummyJSON Users API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MaxRzDev\\DummyJsonUserClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaxRzDev\\DummyJsonUserClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test-integration": "phpunit --testsuite Integration",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
